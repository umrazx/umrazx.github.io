---
import '@fontsource/anton/latin-400.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import serifItalicUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import { person, social, projects } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = person.title, description = person.description, noindex = false } = Astro.props;
const site = Astro.site!;
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/^\/+/, '');
const canonical = new URL(path, site).href;
const ogImage = new URL('og.png', site).href;

const personLd = {
  '@type': 'Person',
  '@id': `${site.href}#person`,
  name: person.name,
  url: site.href,
  image: ogImage,
  email: `mailto:${person.email}`,
  jobTitle: person.role,
  description: person.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
  worksFor: { '@type': 'Organization', name: 'More Retail Private Limited' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Presidency University, Bengaluru' },
  knowsAbout: ['React', 'Next.js', 'TypeScript', 'React Native', 'Web performance', 'Core Web Vitals', 'Design systems', 'Python', 'FastAPI', 'Cybersecurity'],
  sameAs: [social.github, social.linkedin, social.x, social.medium, social.codewars, social.hackthebox],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.href}#website`, url: site.href, name: person.name, inLanguage: 'en', publisher: { '@id': `${site.href}#person` } },
    {
      '@type': 'ProfilePage',
      '@id': `${site.href}#profile`,
      url: site.href,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${site.href}#website` },
      mainEntity: personLd,
    },
    {
      '@type': 'ItemList',
      name: 'Selected work by Umraz Khan',
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'CreativeWork', name: p.title, description: p.description, url: p.href, creator: { '@id': `${site.href}#person` } },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Umraz Khan, full-stack engineer" />
    <meta property="og:locale" content="en_IN" />
    <meta property="profile:first_name" content="Umraz" />
    <meta property="profile:last_name" content="Khan" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@assassinumz" />

    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = false;
        try { seen = sessionStorage.getItem('intro') === '1'; } catch (e) {}
        if (reduce) d.classList.add('reduce');
        if (!reduce && !seen) d.classList.add('loading');
        else d.classList.add('ready');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
